# servers
PORT=5002
NODE_ENV=development
MONGODB_URI = your_mongodb_atlas_connection_string
# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173
# JWT secrets — use long random strings in production
JWT_SECRET= your_jwt_secret
JWT_STUDENT_SECRET= your_student_jwt_secret
JWT_ADMIN_SECRET= your_admin_jwt_secret
JWT_INACTIVITY_MINUTES=10
# Email — Resend (https://resend.com)
# 1. Sign up at resend.com
# 2. Create an API key at resend.com → API Keys
# 3. Add a verified email at resend.com → Domains & SMTP → Add email address
#    (free tier: can only send to verified email addresses)
# 4. For development use: onboarding@resend.dev (sandbox — sends to verified emails only)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev